# concurrency/06-lock-ordering — AB/BA deadlock with std::lock_guard, fixed
# with std::scoped_lock.
#
# Builds one binary:
#   lock_ordering   --mode deadlock   reproduces a forced AB/BA deadlock
#                                     and never exits on its own
#                   --mode fixed      the same opposing acquisition order
#                                     via std::scoped_lock; always completes
#
# The runtime stage installs Lua 5.4 (verify.lua) and the FULL `coreutils`
# package rather than relying on whatever `timeout`/`kill` equivalents ship
# in ubi-minimal's default `coreutils-single` multi-call binary -- this
# demo's hard assertions depend on both being present and standards-
# conformant (`timeout`'s exit-124-on-kill contract, and `kill` plus shell
# job control (`$!`) for the /proc/<pid>/task/*/wchan probe), so the
# dependency is made explicit instead of assumed.

FROM registry.access.redhat.com/ubi10/ubi:10.2 AS builder

RUN dnf install -y --quiet --setopt=install_weak_deps=False \
        gcc gcc-c++ \
        cmake ninja-build python3-pip \
        which \
    && dnf clean all \
    && rm -rf /var/cache/dnf/*

RUN pip install --quiet "conan~=2.0"

# Profile detection + cppstd=gnu17 for dependency builds (fmt). Our own
# target overrides to C++20 in CMakeLists (the two-layer pattern the
# sibling mechanical-sympathy example also uses: deps at gnu17, our code at
# the standard the chapter is actually teaching).
RUN conan profile detect --force && \
    sed -i 's|^compiler.cppstd=.*|compiler.cppstd=gnu17|' \
        /root/.conan2/profiles/default

WORKDIR /src

COPY conanfile.txt ./
RUN conan install . --output-folder=build/conan \
        -s build_type=Release \
        --build=missing

COPY CMakeLists.txt ./
COPY src/ ./src/

RUN cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE=build/conan/conan_toolchain.cmake \
    && cmake --build build -j"$(nproc)" \
    && strip --strip-all build/lock_ordering

# ════════════════════════════════════════════════════════════════════════
# Runtime — ubi-minimal + libstdc++ + Lua 5.4 (verify.lua runs here) +
# full coreutils (timeout, kill, cat -- see header comment).
# ════════════════════════════════════════════════════════════════════════
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2 AS runtime

# UBI-minimal without an entitlement: microdnf's subscription-manager
# plugin prints a harmless "Found 0 entitlement certificates" on each
# install. Turn plugins off to keep the build log clean.
RUN printf 'plugins=0\n' >> /etc/dnf/dnf.conf

RUN microdnf install -y --setopt=install_weak_deps=0 \
        libstdc++ \
        lua \
    && microdnf clean all \
    && rm -rf /var/cache/yum

WORKDIR /demo
COPY --from=builder /src/build/lock_ordering /usr/local/bin/lock_ordering
COPY verify.lua ./verify.lua

ENV LOCK_ORDERING_BIN=/usr/local/bin/lock_ordering

# No service, no ports: a batch binary plus its Lua assertion harness.
CMD ["lua", "verify.lua"]
