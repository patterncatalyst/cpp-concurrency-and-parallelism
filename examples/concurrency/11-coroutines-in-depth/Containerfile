# concurrency/11-coroutines-in-depth — generator, Task<T>, and HALO.
#
# Builds one binary:
#   coroutines_in_depth   prints a 10-term Fibonacci sequence from a
#                         hand-rolled Generator<T>, the result of a
#                         Task<T> chain driven through symmetric transfer,
#                         and an instrumented-operator-new observation of
#                         coroutine frame sizes (tiny vs. a 4 KiB-carrying
#                         frame) for the HALO discussion.
#
# Same shape as the sibling 20-mechanical-sympathy image: one Conan
# dependency (fmt, output formatting only -- the coroutine machinery
# itself is pure C++20 standard library, no external dependency needed).
# Runtime stage installs Lua 5.4 for verify.lua, same as every sibling demo.

FROM registry.access.redhat.com/ubi10/ubi:10.2 AS builder

RUN dnf install -y --quiet --setopt=install_weak_deps=False \
        gcc gcc-c++ \
        cmake ninja-build python3-pip \
        which \
    && dnf clean all \
    && rm -rf /var/cache/dnf/*

RUN pip install --quiet "conan~=2.0"

# Profile detection + cppstd=gnu17 for dependency builds (fmt). Our own
# target overrides to C++20 in CMakeLists -- the two-layer pattern the
# sibling 20-mechanical-sympathy example also uses: deps at gnu17, our code
# at the standard the chapter is actually teaching.
RUN conan profile detect --force && \
    sed -i 's|^compiler.cppstd=.*|compiler.cppstd=gnu17|' \
        /root/.conan2/profiles/default

WORKDIR /src

COPY conanfile.txt ./
RUN conan install . --output-folder=build/conan \
        -s build_type=Release \
        --build=missing

COPY CMakeLists.txt ./
COPY src/ ./src/

RUN cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE=build/conan/conan_toolchain.cmake \
    && cmake --build build -j"$(nproc)" \
    && strip --strip-all build/coroutines_in_depth

# ════════════════════════════════════════════════════════════════════════
# Runtime — ubi-minimal + libstdc++ + Lua 5.4 (verify.lua runs here).
# ════════════════════════════════════════════════════════════════════════
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2 AS runtime

# UBI-minimal without an entitlement: microdnf's subscription-manager
# plugin prints a harmless "Found 0 entitlement certificates" on each
# install. This stage installs only base runtime libs (no dnf plugin
# needed), so turn plugins off to keep the build log clean.
RUN printf 'plugins=0\n' >> /etc/dnf/dnf.conf
RUN microdnf install -y --setopt=install_weak_deps=0 \
        libstdc++ \
        lua \
    && microdnf clean all \
    && rm -rf /var/cache/yum

WORKDIR /demo
COPY --from=builder /src/build/coroutines_in_depth /usr/local/bin/coroutines_in_depth
COPY verify.lua ./verify.lua

ENV COROUTINES_IN_DEPTH_BIN=/usr/local/bin/coroutines_in_depth

# No service, no ports: a batch binary plus its Lua assertion harness.
# CMD runs verify.lua by default; the demo also allows overriding the
# command to run coroutines_in_depth directly for ad hoc inspection.
CMD ["lua", "verify.lua"]
